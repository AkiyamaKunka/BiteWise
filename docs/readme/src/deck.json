      "id": "11-cost",
      "layout": "free",
      "theme": "clay",
      "copy_style": "left:112px;top:0;bottom:0;width:640px;justify-content:center",
      "style": ".l-free .headline{font-size:80px}.costcard{position:absolute;left:830px;top:178px;width:660px;z-index:6;padding:36px 38px 34px;border-radius:30px;background:rgba(255,255,255,.06);box-shadow:0 0 0 1px rgba(255,255,255,.16),0 40px 80px -40px rgba(60,20,8,.6)}.costcard h4{font-size:24px;font-weight:650;color:#FFE3D3;letter-spacing:.01em;margin-bottom:20px}.costcard .namechips span{background:rgba(255,255,255,.92);color:#5A2614;box-shadow:none;font-size:21px}.costcard .namechips span.own{background:transparent;color:#fff;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.6)}.costcard .ln{margin-top:26px;padding-top:24px;border-top:1px solid rgba(255,255,255,.18);display:grid;gap:14px}.costcard .ln p{font-size:21px;line-height:1.42;color:#FBE3D6;padding-left:22px;position:relative}.costcard .ln p::before{content:'';position:absolute;left:0;top:11px;width:9px;height:9px;border-radius:50%;background:#FFCDB2}",
      "en": {
        "eyebrow": "What it costs",
        "headline": "Free app.<br><em>No subscription.</em>",
        "sub": "Use a key from the AI you choose. If it charges, you pay it directly, never the app.",
        "chips": [
          "No in-app purchases",
          "Typing numbers needs no key"
        ],
        "html": "<div class=\"costcard\"><h4>Works with your key from</h4><div class=\"namechips\"><span>Google Gemini</span><span>OpenAI</span><span>Anthropic</span><span>xAI</span><span>OpenRouter</span><span>DeepSeek</span><span>Alibaba Qwen</span><span>ByteDance Doubao</span><span>Zhipu GLM</span><span class=\"own\">or your own server</span></div><div class=\"ln\"><p>Google Gemini, the default, has a free tier. On it, Google says it may use what you send to improve its products.</p><p>DeepSeek, Qwen, Doubao and GLM process data in mainland China.</p><p>Prices change. Check your provider’s pricing page.</p></div></div>",
        "note": "Version 1.6"
      },
      "zh": {
        "eyebrow": "费用",
        "headline": "应用免费，<br><em>没有订阅。</em>",
        "sub": "用你自己选的 AI 的 Key；如果收费，费用直接付给服务商，不付给应用。",
        "chips": [
          "无 App 内购买",
          "自己输入数字不需要 Key"
        ],
        "html": "<div class=\"costcard\"><h4>可以用这些服务商的 Key</h4><div class=\"namechips\"><span>Google Gemini</span><span>OpenAI</span><span>Anthropic</span><span>xAI</span><span>OpenRouter</span><span>DeepSeek 深度求索</span><span>Qwen 通义千问</span><span>Doubao 豆包</span><span>GLM 智谱</span><span class=\"own\">或者你自己的服务器</span></div><div class=\"ln\"><p>默认的 Google Gemini 有免费额度；按 Google 的说法，使用免费额度时，它可能把你发送的内容用于改进自己的产品。</p><p>DeepSeek、通义千问、豆包和智谱在中国大陆处理数据。</p><p>价格会变，请查看服务商的定价页面。</p></div></div>",
        "note": "1.6 版本"
      }
    },
