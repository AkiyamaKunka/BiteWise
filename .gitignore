# Environments
.env
.env.*
!.env.example
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Database
*.db
*.sqlite3

# Logs and Reports
logs/
reports/
*.log

# Local mobile/client config
.calorie_tracker_upload.json
android/.calorie_tracker_upload.json
dietary_profile.txt

# Generated Shortcuts exports can embed API keys.
ios/*.shortcut
ios/*.wflow
*.shortcut
*.wflow

# Local artifacts
outputs/

# Signing material — never commit (docs/RELEASING.md). app/android/.gitignore
# repeats the Android ones; these cover the whole tree, including a .p12 or
# .mobileprovision dropped next to the iOS project by mistake.
*.jks
*.keystore
key.properties
*.p12
*.mobileprovision
*.p8
*.cer
*.certSigningRequest

# OS generated files
.DS_Store
