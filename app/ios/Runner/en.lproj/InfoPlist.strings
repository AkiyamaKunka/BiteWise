/* Home-screen label. Mirrors Info.plist; the zh-Hans variant is the point. */
"CFBundleDisplayName" = "Bitewise";
"NSPhotoLibraryUsageDescription" = "Bitewise reads your photo library to find food photos — the ones you pick and, if you turn on Watch Camera Roll, new photos automatically. Photos it analyzes are sent to the AI service you choose in Settings. If you turn on restaurant lookup with photo location, Bitewise also reads where a restaurant meal photo was taken, only to ask Apple Maps which restaurants are nearby and to remember, on this phone, the restaurants you confirm or rule out there.";
"NSBluetoothAlwaysUsageDescription" = "Bitewise connects to your Meta glasses over Bluetooth during a glasses session, to receive the food photos you take with them.";
"NSBluetoothPeripheralUsageDescription" = "Bitewise connects to your Meta glasses over Bluetooth during a glasses session, to receive the food photos you take with them.";
