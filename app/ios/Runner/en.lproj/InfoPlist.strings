/* Home-screen label. Mirrors Info.plist; the zh-Hans variant is the point. */
"CFBundleDisplayName" = "Chopstats";
"NSPhotoLibraryUsageDescription" = "Chopstats reads your photo library to find food photos — the ones you pick and, if you turn on Watch Camera Roll, new photos automatically. Photos it analyzes are sent to the AI service you choose in Settings. If you turn on restaurant lookup with photo location, Chopstats also reads where a restaurant or takeout meal photo was taken, only to check on this phone whether it was taken in the US, to ask Apple Maps which restaurants are nearby and to remember, on this phone, the restaurants you confirm or rule out there.";
"NSBluetoothAlwaysUsageDescription" = "Chopstats connects to your Meta glasses over Bluetooth during a glasses session, to receive the food photos you take with them.";
"NSBluetoothPeripheralUsageDescription" = "Chopstats connects to your Meta glasses over Bluetooth during a glasses session, to receive the food photos you take with them.";
