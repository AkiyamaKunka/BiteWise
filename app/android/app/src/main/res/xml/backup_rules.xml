<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (android:fullBackupContent; Android 12+ reads
     data_extraction_rules.xml instead). Keeps the backup-excluded local
     store (lib/services/local_store.dart, files/bitewise_local/) and
     flutter_secure_storage's shared_prefs files (the API keys, encrypted
     with a Keystore key that never leaves this phone) out of Auto Backup
     and device-to-device transfer; data_extraction_rules.xml says why.
     Exclude-only on purpose: with no <include>, everything else is backed
     up exactly as before. -->
<full-backup-content>
    <exclude domain="file" path="bitewise_local/"/>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>
</full-backup-content>
