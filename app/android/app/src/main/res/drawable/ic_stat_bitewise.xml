<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: the app mark (progress ring + three dots) as a
     white-on-transparent silhouette. Android draws a small icon from its
     alpha channel only, so the full-colour launcher art came out as a blank
     circle in the status bar and the shade header. The unfilled track is
     kept at partial alpha so the ring still reads as a ring. Referenced only
     by name from Dart (notifications.dart), so res/raw/keep.xml keeps it
     through release resource shrinking. -->
