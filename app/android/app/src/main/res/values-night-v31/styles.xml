<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later (API 31+), Dark Mode on: the splash screen and
         the launch window in the app's dark page colour
         (AppColors.dark.page, lib/ui/theme/tokens.dart). Only LaunchTheme is
         overridden here; NormalTheme still comes from values-night/styles.xml.
         Keep the parent and windowBackground in step with LaunchTheme there. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowSplashScreenBackground">#FF000000</item>
    </style>
</resources>
