# Copy this file to .env and fill in your private values.
# Never commit .env.

GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id

# Generate a long random value and use the same value on Android/iOS clients.
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANDROID_API_KEY=replace-with-random-upload-api-key

# Optional WeChat/PushPlus daily-report forwarding.
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=

# Optional VPN tuning.
VPN_OFF_COUNTRY_CODES=CN
VPN_REMOTE_CIDRS=
VPN_OFF_REMOTE_CIDRS=

# Set to 1 only when a trusted reverse proxy is the ONLY way to reach the
# upload API (Flask bound to 127.0.0.1: docs/SERVER_TLS.md, section 6); it
# makes VPN evidence honor X-Forwarded-For instead of the direct peer IP.
# While the API can still be reached directly, any client could send that
# header, so leave it empty then.
TRUSTED_PROXY_ENABLED=

# Optional server tuning (defaults shown in comments).
# HEARTBEAT_STALE_WARNING_HOURS=      # warn in Telegram when the phone stops pinging (2; 0 disables)
# HEARTBEAT_STALE_WARNING_COOLDOWN_HOURS=  # min gap between those warnings (12)
# MEAL_RELAY_HOST=            # legacy relay bind address (127.0.0.1)
# MEAL_RELAY_API_KEY=         # legacy relay key (falls back to ANDROID_API_KEY)
# MAX_API_UPLOAD_BYTES=       # upload size cap in bytes (26214400 = 25 MB)
# MAX_CONCURRENT_ANALYSES=    # photo analyses allowed in flight at once (3, clamp 1..16)
# GEMINI_HTTP_DEADLINE_SECONDS=  # wall-clock cap per Gemini call (90, clamp 15..600)
# CAPTURED_AT_MAX_AGE_DAYS=   # oldest client-declared capture date honored, in days (45, clamp 1..365)
# TEXT_EDIT_WINDOW_DAYS=      # NL correction/delete lookback in days (7)
# ECHO_UPLOAD_PHOTOS=         # echo phone-uploaded photos into chat as the meal card image (1; set 0 to disable)
# VPN_GEO_LOOKUP_ENABLED=     # IP geolocation for VPN evidence (true)
# CALORIE_BOT_SERVICE_NAME=   # systemd unit shown by /status (caloriebot.service)
# API_BIND_HOST=              # Flask bind address (0.0.0.0); 127.0.0.1 only once plain HTTP is closed (docs/SERVER_TLS.md, section 6)
# Gemini retry/quota and VPN-warning cooldown knobs also exist as env vars —
# see the constants at the top of telegram_bot.py.

# Optional Garmin daily-activity pull.
# GARMIN_ENABLED=            # 1 to enable (needs garminconnect + token dir)
# GARMIN_TOKEN_DIR=          # pre-minted ~/.garminconnect token directory
# GARMIN_NET_USE_TOTAL=      # 1: net against whole-day total, default active-only

# Optional Claude-first photo analysis (subscription-funded via Claude Code CLI).
# CLAUDE_ANALYZER_ENABLED=          # 1 to try Claude before Gemini
# CLAUDE_ANALYZER_BIN=              # CLI binary name/path resolved on PATH (claude)
# CLAUDE_ANALYZER_MODEL=            # optional --model override (default: CLI default)
# CLAUDE_ANALYZER_TIMEOUT_SECONDS=  # per-analysis wall clock (default 120, clamp 10..600)
# Dispatch mode: 'stream' (default) sends the photo on stdin as base64 for a
# single model turn (~8s vs ~16s measured); a stream-shaped failure retries
# once via the old temp-file Read path automatically. Set 'file' ONLY to
# force the old two-turn path (rollback knob). Neither applies to the app's
# API requests: their prompt holds caller text, so they always run the
# no-tools stream dispatch and never the Read path (a CLI without
# stream-json then answers app photos with 503).
# CLAUDE_ANALYZER_DISPATCH=
# Extra CLI flags appended verbatim (shlex-split) to every analyzer run.
# Candidates that shave CLI startup overhead: --strict-mcp-config --no-session-persistence
# WARNING: verify the installed CLI on the VM actually supports a flag before
# setting it (`claude --help`) — an unknown flag fails EVERY photo analysis
# over to Gemini. Default: empty.
# CLAUDE_ANALYZER_EXTRA_FLAGS=
# CLAUDE_CODE_OAUTH_TOKEN=          # mint on a trusted machine with `claude setup-token`

# Optional restaurant lookup for the app (/api/restaurant_lookup): published
# chain-restaurant nutrition via the Claude CLI with WebSearch ONLY (no
# WebFetch, no MCP, minimal child env, init-event guard). Off by default.
# Follow the order in docs/SERVER_DEPLOY.md ("Restaurant lookup"): first
# `scripts/lookup_smoke.py --init-only` (on a 1 GB server only that: a full
# run is a second CLI run next to the service, and two do not fit), and
# TLS in front (docs/SERVER_TLS.md).
# CLAUDE_LOOKUP_ENABLED=            # 1 to enable (default off: the endpoints answer 403)
# haiku uses less plan usage but was wrong on build-your-own items in the
# first live runs (2026-11-05), which took about 25-135 s per lookup.
# CLAUDE_LOOKUP_MODEL=              # sonnet (default) or haiku
# CLAUDE_LOOKUP_TIMEOUT_SECONDS=    # per-lookup wall clock (180, clamp 20..300)
# CLAUDE_LOOKUP_INIT_SECONDS=       # time allowed for the CLI's init event (10, clamp 5..30)
# CLAUDE_LOOKUP_DAILY_CAP=          # started lookup runs per day (30, clamp 0..500)
# CLAUDE_LOOKUP_KEY_SOURCE=         # init apiKeySource values accepted (none); set only if the smoke says so
